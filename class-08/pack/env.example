# Copy this to .env and fill in the values.
#
#   cp .env.example .env
#
# THIS file is tracked in git. THAT one never is - see .gitignore.
# The names are useful to share. The values are not.

# ── n8n ─────────────────────────────────────────────────────────────────────
# The key that decrypts every credential n8n has saved. If you lose it, every
# saved credential becomes unreadable. If you leak it, they become readable to
# whoever has it AND a copy of the database.
N8N_ENCRYPTION_KEY=

# Your timezone. Leave it unset and n8n runs on UTC, which is why a 7am
# schedule can fire at 2am. Changing it needs a container restart - n8n reads
# environment variables when it starts and never again.
GENERIC_TIMEZONE=

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Models (Class 1) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Class 4, if you built the voice bot ─────────────────────────────────────
BRAIN_BOT_TOKEN=
BRAIN_OWNER_ID=

# ── Class 7, if you built the calendar reader ───────────────────────────────
# Read access to your entire calendar, for anyone holding it. Not a scoped
# token. Belongs in an n8n credential rather than here if you can manage it.
BRAIN_ICAL_URL=
